# Workspace editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Exclude term-project entirely
term-project/

# Frontend (Vite / Node)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/*.local
frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Backend (Gradle / Spring)
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/.apt_generated/
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache/
backend/.idea/

# Keep Gradle wrapper tracked
!backend/gradle/wrapper/gradle-wrapper.jar
